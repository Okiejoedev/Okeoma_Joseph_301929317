        API1["Stateless API pods"]
        PG1[("PostgreSQL PRIMARY<br/>ledger + wallets")]
        M1[("MongoDB member 1")]
        R1[("Redis primary")]
    end
    subgraph LAG2["Lagos site B (second facility / zone)"]
        API2["Stateless API pods"]
        PG2[("PostgreSQL SYNC standby")]
        M2[("MongoDB member 2")]
        R2[("Redis replica + Sentinel")]
    end
    subgraph ABJ["Abuja DR site"]
        PG3[("PostgreSQL ASYNC standby<br/>+ reporting reads")]
        M3[("MongoDB member 3")]
        BK[("WAL archive + backups<br/>encrypted, in Nigeria")]
