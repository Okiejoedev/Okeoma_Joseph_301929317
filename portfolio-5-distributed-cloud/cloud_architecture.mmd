flowchart TB
    subgraph POS["Edge: 3,000+ POS terminals"]
        T["POS app + local SQLite queue<br/>(store-and-forward when offline)"]
    end
    T -->|"TLS, idempotent txn_ref"| LB["API gateway / load balancer<br/>(Lagos)"]
